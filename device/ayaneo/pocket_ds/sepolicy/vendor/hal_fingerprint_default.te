# FocalTech side fingerprint sensor. Both the fingerprint HAL and FocalTech's
# extension service run in this domain, as on stock.
add_service(hal_fingerprint_default, focal_fingerprint_service)
add_hwservice(hal_fingerprint_default, focal_fingerprint_hwservice)

binder_call(hal_fingerprint_default, hal_fingerprint_default)
vndbinder_use(hal_fingerprint_default)

allow hal_fingerprint_default {
    focal_fingerprint_device
    tee_device
}:chr_file rw_file_perms;

allow hal_fingerprint_default fingerprint_vendor_data_file:dir create_dir_perms;
allow hal_fingerprint_default fingerprint_vendor_data_file:file create_file_perms;

# uevent/netlink
allow hal_fingerprint_default self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;
allow hal_fingerprint_default self:netlink_socket create_socket_perms_no_ioctl;
