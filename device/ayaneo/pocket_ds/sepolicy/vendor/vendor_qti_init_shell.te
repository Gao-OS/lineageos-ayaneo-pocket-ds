dontaudit vendor_qti_init_shell debugfs:filesystem mount;
dontaudit vendor_qti_init_shell default_prop:file *;

# charger_fan_speed.sh reads the stored fan speed through tsnv_test and
# writes it to the PWM fan.
allow vendor_qti_init_shell tsnv_test_exec:file rx_file_perms;
allow vendor_qti_init_shell tsnv_device:chr_file rw_file_perms;
allow vendor_qti_init_shell vendor_sysfs_fan:dir r_dir_perms;
allow vendor_qti_init_shell vendor_sysfs_fan:file rw_file_perms;
